FLASK_SECRET_KEY=change-me

# Firebase (Firestore + Auth verification on the server)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/serviceAccountKey.json

# Hugging Face Inference Providers - Stable Audio 3
# NOTE: not issued yet. Fill this in once the API key is available;
# the /api/posts generation endpoint returns a clear error until then.
HF_API_TOKEN=
HF_MODEL_ID=stabilityai/stable-audio-open-1.0

# OpenAI (ChatGPT) - composes the orchestral score as MusicXML from the
# prompt/mood/tempo. Without a key, a local placeholder melody is used
# instead so the flow still works end to end.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
